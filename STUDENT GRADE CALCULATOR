#include <stdio.h>
//STUDENT GRADE CALCULATOR 

int main(){
    int marks;
    printf("Enter your marks out of 100\n");
    scanf("%d",&marks);
     if(marks>=90 && marks<=100){
        printf("Grade: A");
     }
     else if(marks>=75 && marks<=89){
        printf("Grade: B");
     }
     else if(marks>=60 && marks<=74){
        printf("Grade: C");
     }
     else if(marks>=40 && marks<=59){
        printf("Grade: D");
     }
     else{
        printf("Grade: Fail");
     }
     return 0;

}
