#include <stdio.h>
//SIMPLE CALCULATOR

int main(){
int num1,num2;
char operator;
int result;

printf("Enter the two numbers\n");
scanf("%d%d",&num1,&num2);
printf("Select any 1 operation you want to perform +,-,*,/\n");
scanf(" %c",&operator);

switch(operator){

    case '+':
    result=num1+num2;
    break;

    case '-':
    result=num1-num2;
    break;

    case '*':
    result=num1*num2;
    break;

    case '/':
    if(num2!=0){
     result=num1/num2;
     break;
    }
    else{
        printf("Division by zero is not allowed");
         return 0;
    }
    
    default:
    printf("Invalid Operator");
    return 0;
   
}
printf("Result= %d",result);
return 0;
}
